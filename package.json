{
  "name": "yuda-website",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate:og": "node scripts/generate-og.mjs",
    "generate:site-assets": "node scripts/generate-site-assets.mjs",
    "prebuild": "pnpm generate:site-assets",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check"
  },
  "dependencies": {
    "@chinese-fonts/dyh": "3.0.0",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@fontsource/space-mono": "5.3.0",
    "@fontsource/unbounded": "5.3.0",
    "@gsap/react": "2.1.2",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-router": "1.170.30",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-start": "1.168.47",
    "gsap": "3.15.0",
    "i18next": "25.10.10",
    "lenis": "1.3.27",
    "nitro": "3.0.260610-beta",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "16.6.6",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-cli": "1.167.30",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
